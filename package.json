        "@connectrpc/connect": "^2.1.2",
        "@connectrpc/connect-node": "^2.1.2",
        "@fastify/multipart": "^9.4.0",
        "@grpc/grpc-js": "^1.14.4",
        "@nestjs/common": "12",
        "@nestjs/core": "^12",
        "@nestjs/microservices": "^12",
        "@nestjs/websockets": "^12",
        "amqplib": "^2.0.1",
        "commander": "^15.0.0",
        "fastify": "^5",
        "jose": "^6.0.11",
        "openid-client": "^6.5.0",
        "rxjs": "^7",
        "socket.io": "^4.8.1",
        "zod": "^4"
