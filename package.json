{
    "name": "@dre44/nestjs-kit",
    "version": "0.52.0",
    "description": "Some NestJS utility",
    "main": "dist/index.js",
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./connectrpc": "./dist/connectrpc/index.js",
        "./fastify-multipart": "./dist/fastify-multipart/index.js",
        "./grpc-js": "./dist/grpc-js/index.js",
        "./interactive": "./dist/interactive/index.js",
        "./rabbitmq": "./dist/rabbitmq/index.js",
        "./rpc": "./dist/rpc/index.js",
        "./ws": "./dist/ws/index.js",
        "./zod": "./dist/zod/index.js"
    },
    "scripts": {
        "tc": "tsc --noEmit",
        "tc:watch": "tsc --noEmit --watch",
        "prebuild": "rm -rf dist",
        "build": "tsc",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:build": "buf generate buf.build/fdc/exhyve-runtime --template test/buf.gen.yaml"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/andre-hctulc/nestjs-kit.git"
    },
    "keywords": [
        "nestjs",
        "nestjs-kit",
        "nestjs utilities",
        "nestjs utilities kit"
    ],
    "author": "André Thomas",
    "license": "ISC",
